# Jarvis RUNTIME/DEPLOY config. Copy to .env (git-ignored) and fill in.
# This is for running/deploying Jarvis itself — NOT for the devcontainer.
# Devcontainer secrets (GITHUB_PAT, CONTEXT7_API_KEY) live in .devcontainer/devcontainer.env.

# ---- Deployment (used by .github/workflows/deploy.yml; backlog E6) ----------
# In CI these are repo Actions secrets; listed here for local/reference use.
PI_SSH_HOST=
PI_SSH_USER=
PI_SSH_KEY=
PI_SSH_KNOWN_HOSTS=

# ---- Agent runtime (fill in as the agent lands; backlog E3) -----------------
# e.g. cloud model endpoints/keys for async heavy-task routing.
# ANTHROPIC_API_KEY=

# Role backends (docs/architecture.md). <ROLE> = LLM | STT | TTS; empty = unset.
# openai (any OpenAI-compatible server) | mock (default).
JARVIS_LLM_BACKEND=
# Server base URL incl. /v1, e.g. http://ollama:11434/v1 (required for openai).
JARVIS_LLM_BASE_URL=
# Model name on that server, e.g. qwen2.5:1.5b (required for openai).
JARVIS_LLM_MODEL=
# Bearer token, only if the server needs one.
JARVIS_LLM_API_KEY=
JARVIS_STT_BACKEND=
JARVIS_STT_BASE_URL=
JARVIS_STT_MODEL=
JARVIS_STT_API_KEY=
JARVIS_TTS_BACKEND=
JARVIS_TTS_BASE_URL=
JARVIS_TTS_MODEL=
JARVIS_TTS_API_KEY=
# TTS voice name (server-specific).
JARVIS_TTS_VOICE=
# Heavy (async, off-hot-path) LLM, e.g. vLLM or a cloud API. Same keys as LLM, plus
# none (default): heavy tasks then fall back to the local LLM.
JARVIS_HEAVY_LLM_BACKEND=
JARVIS_HEAVY_LLM_BASE_URL=
JARVIS_HEAVY_LLM_MODEL=
JARVIS_HEAVY_LLM_API_KEY=
