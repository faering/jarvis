# Devcontainer secrets. Copy to .devcontainer/devcontainer.env (git-ignored) and fill in.
# Loaded into the container via runArgs --env-file. initializeCommand seeds this
# file from the example on a fresh clone so the container can start.

# GitHub PAT for MCP only. Consumed by .mcp.json (GitHub MCP).
# Use a fine-grained PAT with minimum permissions documented in docs/github-mcp-pat.md.
GITHUB_PAT=

# gh token is forwarded from WSL: GITHUB_TOKEN (see .devcontainer/devcontainer.json).
# If WSL GITHUB_TOKEN is unset, gh falls back to GITHUB_PAT via .bashrc.

# Optional: context7 MCP API key (raises doc-lookup rate limits). Works without one.
# Get one at https://context7.com/dashboard
CONTEXT7_API_KEY=
