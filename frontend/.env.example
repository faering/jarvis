# Copy to frontend/.env.local to override (read by Vite at dev/build time).
# Agent WebSocket URL. Default: ws://127.0.0.1:8000/ws (agent on the same host).
# In the devcontainer the agent is reachable on jarvis-net as ws://agent:8000/ws.
# The URL must also be allowed by the CSP in src-tauri/tauri.conf.json: `devCsp` for
# `tauri dev` (allows 127.0.0.1:8000 and agent:8000), `csp` for packaged builds
# (127.0.0.1:8000 only). Add any other host there too, or the app can't connect.
VITE_AGENT_WS_URL=ws://agent:8000/ws
