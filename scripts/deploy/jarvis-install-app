#!/usr/bin/env bash
# Root-owned installer for the Jarvis app .deb. docs/pi-setup.md installs it as
# /usr/local/sbin/jarvis-install-app, and sudoers lets the deploy user run ONLY this
# (not arbitrary apt-get): it installs a package named "jarvis" from the deploy user's
# ~/jarvis/{incoming,app}/, and nothing else.
#
# Usage:  sudo -n /usr/local/sbin/jarvis-install-app <path-to-jarvis.deb>
# Logs to /var/log/jarvis/jarvis-deploy-<UTC date>.log (docs/logging.md) and stderr.
set -euo pipefail

[[ $# -eq 1 ]] || {
  echo "usage: $(basename "$0") <jarvis .deb>" >&2
  exit 2
}
# Test hooks only; never honoured as root (sudo also resets the environment).
if [[ $EUID -eq 0 ]]; then
  unset JARVIS_INSTALL_HOME APT_GET JARVIS_LOG_LIB JARVIS_LOG_DIR JARVIS_LOG_COMPONENT JARVIS_LOG_TURN
fi

# Shared logger (scripts/lib/log.sh): sourced only if root owns it and its folder and nobody
# else can write them; otherwise a stderr-only fallback. Logging never fails an install.
log_lib="${JARVIS_LOG_LIB:-/usr/local/lib/jarvis/log.sh}"
lib_ok() {
  local p owner mode
  for p in "$1" "$(dirname "$1")"; do
    [[ -e "$p" && ! -L "$p" ]] || return 1
    read -r owner mode < <(stat -c '%u %a' "$p")
    [[ "$owner" == 0 || "$owner" == "$EUID" ]] && (((8#$mode & 8#022) == 0)) || return 1
  done
}
if lib_ok "$log_lib"; then
  # shellcheck source=../lib/log.sh
  . "$log_lib"
else
  log() {
    printf '[%s] [%-5s] [deploy] [%s] [--------] %s\n' \
      "$(date -u '+%F %T.%3NZ')" "$1" "$2" "${*:3}" >&2
  }
  log WARN install.app "shared logger missing or untrusted; logging to stderr only" path="$log_lib"
fi
refuse() { # refuse <message> [key=value ...]
  log ERROR install.app "$@"
  exit 1
}
user="${SUDO_USER:-$(id -un)}"
home="${JARVIS_INSTALL_HOME:-$(getent passwd "$user" | cut -d: -f6)}"

# The path must be literally <home>/jarvis/{incoming,app}/<name>.deb: no "..", no deeper dirs.
case "$1" in
  "$home/jarvis/incoming/"* | "$home/jarvis/app/"*) ;;
  *) refuse "refusing a .deb outside ~/jarvis/{incoming,app}/" path="$1" ;;
esac
rel="${1#"$home"/jarvis/}"
sub="${rel%%/*}" name="${rel#*/}"
if [[ "$name" == */* || "$name" == .* || "$name" != *.deb ]]; then
  refuse "refusing: expected a .deb directly in ~/jarvis/$sub/" path="$1"
fi

# Copy the bytes into a root-owned private file. Every path component below the (root-owned)
# /home is opened with O_NOFOLLOW, relative to its parent's descriptor, and the source must be
# a regular file: a symlink or directory swap by the deploy user can't redirect the copy.
work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT
deb="$work/jarvis.deb"
python3 - "$home" "$sub" "$name" "$deb" <<'PY' || refuse "refusing: could not copy the .deb" path="$1"
import os, shutil, stat, sys
home, sub, name, dest = sys.argv[1:]
nofollow = os.O_RDONLY | os.O_NOFOLLOW
fd = os.open(home, nofollow | os.O_DIRECTORY)
for part in ("jarvis", sub):
    fd = os.open(part, nofollow | os.O_DIRECTORY, dir_fd=fd)
src = os.open(name, nofollow, dir_fd=fd)
if not stat.S_ISREG(os.fstat(src).st_mode):
    sys.exit(f"refusing {name}: not a regular file")
with os.fdopen(src, "rb") as fsrc, open(dest, "xb") as fdst:
    shutil.copyfileobj(fsrc, fdst)
PY
[[ -f "$deb" && ! -L "$deb" ]] || refuse "refusing: no private copy of the .deb" path="$1"

pkg="$(dpkg-deb -f "$deb" Package)"
[[ "$pkg" == jarvis ]] || refuse "refusing: package is not 'jarvis'" path="$1" package="$pkg"
version="$(dpkg-deb -f "$deb" Version)"
log INFO install.app "installing" package="$pkg" version="$version" path="$1"
if "${APT_GET:-apt-get}" install -y --allow-downgrades "$deb"; then
  log INFO install.app "installed" package="$pkg" version="$version"
else
  rc=$?
  log ERROR install.app "apt-get install failed" package="$pkg" version="$version" exit_code="$rc"
  exit "$rc"
fi
