#!/usr/bin/env bash
# Root-owned agent rollout. The Pi setup installs it as /usr/local/sbin/jarvis-deploy-agent
# (root:root 755), and sudoers lets the `deploy` user run ONLY this and jarvis-install-app,
# so the deploy SSH key needs no `docker` group (which is root-equivalent). It pulls only
# ghcr.io/faering/jarvis-agent:<tag> and runs only the root-owned compose file below.
#
# Usage:  sudo -n /usr/local/sbin/jarvis-deploy-agent deploy <docker-tag> <expected-version> <protocol>
#         sudo -n /usr/local/sbin/jarvis-deploy-agent state     # KEY=VALUE, empty if never deployed
# Files:  /opt/jarvis/docker-compose.yml  root-owned compose file (from deploy/pi/)
#         /opt/jarvis/agent.env           root-owned runtime config (JARVIS_*, API keys)
#         /var/lib/jarvis/agent.env       deploy state; compose --env-file, pins AGENT_IMAGE_TAG
#         /var/log/jarvis/jarvis-deploy-<UTC date>.log  log (docs/logging.md), also on stderr
# On failure it rolls back to the previous tag; a failed first deploy removes the agent.
set -euo pipefail

# Test hooks only; never honoured as root (sudo also resets the environment).
if [[ $EUID -eq 0 ]]; then
  unset JARVIS_OPT_DIR JARVIS_STATE_DIR AGENT_HEALTH_TIMEOUT JARVIS_LOG_LIB JARVIS_LOG_DIR \
    JARVIS_LOG_COMPONENT JARVIS_LOG_TURN
  PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
fi
opt="${JARVIS_OPT_DIR:-/opt/jarvis}"
state_dir="${JARVIS_STATE_DIR:-/var/lib/jarvis}"
timeout="${AGENT_HEALTH_TIMEOUT:-120}"
compose_file="$opt/docker-compose.yml"
state="$state_dir/agent.env"
next="$state_dir/agent.env.next"

# Release/dev DOCKER_TAG and CANONICAL grammars from scripts/version.sh; nothing else passes.
tag_re='^[0-9]+\.[0-9]+\.[0-9]+(-[0-9]+-g[0-9a-f]{4,40}(-dirty)?)?$'
version_re='^[0-9]+\.[0-9]+\.[0-9]+(\+[0-9]+\.g[0-9a-f]{4,40}(\.dirty)?)?$'
protocol_re='^([0-9]+|none)$'

# Shared logger (scripts/lib/log.sh): sourced only if root owns it and its folder and nobody
# else can write them; otherwise a stderr-only fallback. Logging never fails a deploy.
log_lib="${JARVIS_LOG_LIB:-/usr/local/lib/jarvis/log.sh}"
lib_ok() {
  local p owner mode
  for p in "$1" "$(dirname "$1")"; do
    [[ -e "$p" && ! -L "$p" ]] || return 1
    read -r owner mode < <(stat -c '%u %a' "$p")
    [[ "$owner" == 0 || "$owner" == "$EUID" ]] && (((8#$mode & 8#022) == 0)) || return 1
  done
}
if lib_ok "$log_lib"; then
  # shellcheck source=../lib/log.sh
  . "$log_lib"
else
  log() {
    printf '[%s] [%-5s] [deploy] [%s] [--------] %s\n' \
      "$(date -u '+%F %T.%3NZ')" "$1" "$2" "${*:3}" >&2
  }
  log WARN deploy.agent "shared logger missing or untrusted; logging to stderr only" path="$log_lib"
fi
info() { log INFO deploy.agent "$@"; }
die() {
  log ERROR deploy.agent "$@"
  exit 1
}
usage() {
  echo "usage: $(basename "$0") deploy <docker-tag> <expected-version> <protocol> | state" >&2
  exit 2
}
state_get() { [[ -f "$1" ]] && sed -n "s/^$2=//p" "$1" | tail -n1 || true; }

# Refuse a file or directory that someone other than root (or, in tests, the caller) could
# have written: a deploy-user-writable compose file would control the container's mounts.
trusted() { # trusted <path>
  local owner mode
  [[ -e "$1" && ! -L "$1" ]] || die "missing or symlinked: $1 (run the Pi setup)"
  read -r owner mode < <(stat -c '%u %a' "$1")
  [[ "$owner" == 0 || "$owner" == "$EUID" ]] || die "refusing $1: owned by uid $owner, not root"
  (((8#$mode & 8#022) == 0)) || die "refusing $1: group/world-writable (mode $mode)"
}

compose() { # compose <env-file> <args...>
  local env="$1"
  shift
  docker compose --project-directory "$opt" -f "$compose_file" --env-file "$env" "$@"
}

# Healthy container + OCI version label (+ /version, once the agent serves it) == expected.
verify() { # verify <env-file> <expected-version> <logger>
  local env="$1" want="$2" lg="$3" cid health label reported deadline=$((SECONDS + timeout))
  while :; do
    cid="$(compose "$env" ps -q agent)"
    health="$([[ -n "$cid" ]] && docker inspect -f '{{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}' "$cid" || echo missing)"
    case "$health" in
      healthy) break ;;
      unhealthy)
        log ERROR "$lg" "container is unhealthy" version="$want"
        return 1
        ;;
    esac
    if ((SECONDS >= deadline)); then
      log ERROR "$lg" "not healthy in time" timeout_s="$timeout" status="$health"
      return 1
    fi
    sleep 2
  done
  label="$(docker inspect -f '{{index .Config.Labels "org.opencontainers.image.version"}}' "$cid")"
  if [[ "$label" != "$want" ]]; then
    log ERROR "$lg" "image version label mismatch" label="$label" expected="$want"
    return 1
  fi
  # /version lands with #28; until then a 404 just skips this check.
  # Print only the JSON "version" field, so the comparison below is exact.
  reported="$(docker exec "$cid" python -c '
import json, sys, urllib.error, urllib.request
try:
    body = urllib.request.urlopen("http://127.0.0.1:8000/version", timeout=3).read()
except urllib.error.HTTPError as e:
    sys.exit(0 if e.code == 404 else 1)
print(json.loads(body)["version"])
')" || {
    log ERROR "$lg" "/version request failed or returned no version field"
    return 1
  }
  if [[ -n "$reported" && "$reported" != "$want" ]]; then
    log ERROR "$lg" "/version mismatch" reported="$reported" expected="$want"
    return 1
  fi
  log INFO "$lg" "healthy" version="$want"
}

# The models this agent is assigned, pulled into the ollama service with the NEW image
# before it replaces the running agent: a failed download leaves the old agent untouched.
# A compose file from before #159 has no ollama service: then say so and skip (the agent
# runs without a profile, as before, until setup is re-run).
pull_models() { # pull_models <env-file>
  local env="$1"
  if ! compose "$env" config --services | grep -qx ollama; then
    log WARN deploy.agent "no ollama service in the compose file; re-run the Pi setup (git pull && sudo scripts/pi/setup.sh)"
    return 0
  fi
  compose "$env" up -d ollama || return 1
  compose "$env" run --rm --no-deps -T agent python -m jarvis_agent.models pull --assigned >&2 || return 1
  info "models ready"
}

cmd_state() {
  [[ -f "$state" ]] || exit 0
  grep -E '^[A-Z_]+=' "$state" || true
}

cmd_deploy() { # cmd_deploy <docker-tag> <expected-version> <protocol>
  local tag="$1" expected="$2" protocol="$3" prev_tag prev_version
  [[ "$tag" =~ $tag_re ]] || die "refusing tag '$tag': not a DOCKER_TAG (scripts/version.sh)"
  [[ "$expected" =~ $version_re ]] || die "refusing version '$expected': not a canonical version"
  [[ "$protocol" =~ $protocol_re ]] || die "refusing protocol '$protocol': not an integer or 'none'"
  # The tag is the version's Docker form (1.2.3+4.gabc.dirty -> 1.2.3-4-gabc-dirty).
  local want_tag="${expected/+/-}"
  want_tag="${want_tag/.g/-g}"
  want_tag="${want_tag/.dirty/-dirty}"
  [[ "$tag" == "$want_tag" ]] || die "refusing tag '$tag': version $expected ships as '$want_tag'"

  trusted "$opt"
  trusted "$compose_file"
  [[ ! -e "$opt/agent.env" ]] || trusted "$opt/agent.env"
  install -d -m 755 "$state_dir"
  trusted "$state_dir"
  exec 9>"$state_dir/deploy.lock"
  flock -n 9 || die "another agent deploy is running"

  docker network inspect jarvis-net >/dev/null 2>&1 || docker network create jarvis-net >/dev/null

  prev_tag="$(state_get "$state" AGENT_IMAGE_TAG)"
  prev_version="$(state_get "$state" VERSION)"
  if [[ -n "$prev_tag" && ! "$prev_tag" =~ $tag_re ]]; then
    log WARN deploy.agent "ignoring malformed previous tag" tag="$prev_tag" file="$state"
    prev_tag=""
  fi
  (
    umask 022
    cat >"$next" <<EOF
AGENT_IMAGE_TAG=$tag
VERSION=$expected
PROTOCOL=$protocol
PREVIOUS_IMAGE_TAG=$prev_tag
PREVIOUS_VERSION=$prev_version
DEPLOYED_AT=$(date -u +%Y-%m-%dT%H:%M:%SZ)
EOF
  )

  info "deploy started" image="ghcr.io/faering/jarvis-agent:$tag" version="$expected" \
    protocol="$protocol" previous="${prev_tag:-none}"
  if ! compose "$next" pull agent || ! pull_models "$next"; then
    log ERROR deploy.agent "image or models not ready; the running agent is untouched" \
      version="$expected"
    rm -f "$next"
    exit 1
  fi
  if compose "$next" up -d agent && verify "$next" "$expected" deploy.agent; then
    mv -f "$next" "$state"
    info "deployed" version="$expected" tag="$tag"
    exit 0
  fi

  if [[ -z "$prev_tag" ]]; then
    # First deploy: nothing to roll back to. Don't leave a broken agent running
    # (restart: unless-stopped would keep restarting it).
    log ERROR deploy.agent "deploy failed; no previous release to roll back to, removing the agent" \
      version="$expected"
    compose "$next" rm -s -f agent || log ERROR deploy.agent "could not remove the failed agent container"
    rm -f "$next"
    exit 1
  fi
  rm -f "$next"
  log WARN rollback "deploy failed, rolling back" version="$expected" to="$prev_tag"
  if compose "$state" up -d agent && verify "$state" "$prev_version" rollback; then
    log INFO rollback "rolled back" version="$prev_version" tag="$prev_tag"
  else
    log ERROR rollback "rollback failed too; the agent needs manual attention" to="$prev_tag"
  fi
  exit 1
}

case "${1:-}" in
  deploy)
    [[ $# -eq 4 ]] || usage
    cmd_deploy "$2" "$3" "$4"
    ;;
  state)
    [[ $# -eq 1 ]] || usage
    cmd_state
    ;;
  *) usage ;;
esac
